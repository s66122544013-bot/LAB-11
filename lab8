# -----------------------------
# Depth-Limited Search
# -----------------------------
def depth_limited_search(graph, current, goal, limit, path=None):
    if path is None:
        path = [current]

    # ตรวจสอบเป้าหมาย
    if current == goal:
        return path

    # ถ้าเกิน depth limit
    if limit <= 0:
        return None

    # ขยายโหนดลูก
    for neighbor in graph.get(current, {}):
        if neighbor not in path:  # ป้องกัน loop
            result = depth_limited_search(
                graph,
                neighbor,
                goal,
                limit - 1,
                path + [neighbor]
            )
            if result is not None:
                return result

    return None


# --------- ทดสอบ ---------
start_city = "Pattaya"
goal_city = "UdonThani"
depth_limit = 6

result = depth_limited_search(TH_ROADS, start_city, goal_city, depth_limit)

print(f"--- DLS Result (Limit: {depth_limit}) ---")

if result:
    print("Path Found:", " -> ".join(result))
    print("Steps:", len(result) - 1)
else:
    print("No path found within depth limit")
